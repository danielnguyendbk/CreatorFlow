{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatorFlow committed runtime cycle handoff",
  "type": "object",
  "required": ["schemaVersion", "cycleId", "generatedAtUtc", "source", "branch", "lastImplementationCommit", "sourceContextStatus", "tasks", "changedFiles", "limits"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "cycleId": {"type": "string", "format": "uuid"},
    "generatedAtUtc": {"type": "string", "format": "date-time"},
    "source": {"const": "COMMITTED_POSTGRESQL_STATE"},
    "branch": {"type": "null"},
    "lastImplementationCommit": {"type": "null"},
    "sourceContextStatus": {"const": "NOT_PROVIDED_NO_REPOSITORY_COMMIT_CLAIM"},
    "changedFiles": {"type": "array", "maxItems": 0},
    "limits": {"type": "array", "items": {"type": "string"}},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "node_key", "kind", "state", "attempt", "result_json", "error_code"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "node_key": {"type": "string", "pattern": "^[a-z0-9_-]{1,48}$"},
        "kind": {"enum": ["GIT_FIXTURE", "FFMPEG_FIXTURE", "CAPABILITY_PROBE"]},
        "state": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED"]},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 3},
        "result_json": {"type": ["object", "null"]},
        "error_code": {"type": ["string", "null"]}
      }
    }},
    "completedTasks": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "incompleteTasks": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "tests": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "nextCycle": {"type": "object", "required": ["firstTask"], "properties": {"firstTask": {"enum": ["CYCLE_COMPLETE", "OPERATOR_REVIEW"]}}, "additionalProperties": false}
  }
}
